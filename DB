CREATE TABLE cliente (
    id_cliente SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
   	telefone VARCHAR(15) NOT NULL,
    email VARCHAR(70),
	data_registo TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE loja (
    id_loja SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
    morada VARCHAR(100),
    telefone VARCHAR(15) NOT NULL
);

CREATE TABLE barbeiro (
    id_barbeiro SERIAL PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
	atividade BOOLEAN DEFAULT TRUE
);


CREATE TABLE barbeiro_loja (
    id_barbeiro int NOT NULL,
    id_loja int NOT NULL,

   PRIMARY KEY (id_barbeiro, id_loja),

    CONSTRAINT fk_barbeiro_loja_barbeiro
        FOREIGN KEY (id_barbeiro) REFERENCES BARBEIRO(id_barbeiro)
        ON DELETE CASCADE,

    CONSTRAINT fk_barbeiro_loja_loja
        FOREIGN KEY (id_loja) REFERENCES LOJA(id_loja)
        ON DELETE CASCADE
);


CREATE TABLE marcacao (
    id_marcacao SERIAL PRIMARY KEY,
    data_hora timestamp NOT NULL,
    id_cliente INT NOT NULL,
    id_barbeiro INT NOT NULL,
    id_loja INT NOT NULL,
	status VARCHAR (25) NOT NULL,
    CONSTRAINT fk_marcacao_cliente
        FOREIGN KEY (id_cliente) REFERENCES CLIENTE(id_cliente),

    CONSTRAINT fk_marcacao_barbeiro
        FOREIGN KEY (id_barbeiro) REFERENCES BARBEIRO(id_barbeiro),

    CONSTRAINT fk_marcacao_loja
        FOREIGN KEY (id_loja) REFERENCES LOJA(id_loja),

    CONSTRAINT fk_marcacao_barbeiro_loja
        FOREIGN KEY (id_barbeiro, id_loja)
        REFERENCES BARBEIRO_LOJA(id_barbeiro, id_loja)
);
